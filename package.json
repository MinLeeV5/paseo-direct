{
  "name": "paseo-direct",
  "version": "1.0.1",
  "type": "module",
  "description": "Discover, verify and manage foreground direct connections for Paseo",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/MinLeeV5/paseo-direct.git" },
  "homepage": "https://github.com/MinLeeV5/paseo-direct#readme",
  "bugs": { "url": "https://github.com/MinLeeV5/paseo-direct/issues" },
  "keywords": ["paseo", "paseo-plugin", "direct-connection", "lan"],
  "files": ["paseo-plugin.json", "index.client.tsx", "index.server.ts", "client/", "server/", "shared/", "assets/", "OVERVIEW.md", "OVERVIEW.zh-CN.md", "CHANGELOG.md", "LICENSE", "docs/releasing.md", "docs/verification.md", "docs/research/paseo-direct-feasibility.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:daemon": "node --import tsx scripts/verify-daemon.ts",
    "verify": "npm run typecheck && npm test",
    "release:pack": "npm run verify && node scripts/pack.mjs",
    "prepublishOnly": "npm run verify",
    "reports": "node --import tsx scripts/reports.ts"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.2",
    "@getpaseo/plugin": "0.13.2",
    "@getpaseo/protocol": "0.13.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "engines": { "node": ">=22" }
}
